# Dynamic Class Track - Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DATABASE_URL=sqlite:///instance/dynamic_class_track.db

# College details
COLLEGE_NAME="Gayatri Vidya Parishad College of Engineering for Women"
COLLEGE_SHORT_NAME="GVPCEW"
TIMEZONE="Asia/Kolkata"

# OCR Configuration
# If Tesseract is not in system PATH, provide the full binary path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Web Push (VAPID) Keys for browser push notifications
# Generate keys with: vapid --gen or use py_vapid CLI
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@gvpcew.ac.in

# Upload limits (bytes) - 16MB default
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
